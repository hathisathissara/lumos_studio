RewriteEngine On
Options +FollowSymLinks -MultiViews
RewriteBase /dinith/
php_value post_max_size 100M
php_value upload_max_filesize 100M
php_value max_execution_time 300
php_value max_input_time 300
php_value max_file_uploads 50





RewriteRule ^/?$ index.php [L]
RewriteRule ^home/?$ index.php [L]
RewriteRule ^albums/?$ albums.php [L]
RewriteRule ^packages/?$ packages.php [L]
RewriteRule ^portfolio/?$ portfolio.php [L]
RewriteRule ^about/?$ about.php [L]
RewriteRule ^contact/?$ contact.php [L]
RewriteRule ^login/?$ admin/login.php [L]
RewriteRule ^admin/?$ admin/dashboard.php [L]
RewriteRule ^view_album/?$ view_album.php [L]
RewriteRule ^view_album/([0-9]+)/?$ view_album.php?id=$1 [L]
RewriteRule ^albums/([a-zA-Z0-9-]+)/?$ view_album.php?slug=$1 [L]



ErrorDocument 404 /dinith/404.php

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
</IfModule>