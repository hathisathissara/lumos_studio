RewriteEngine On
Options +FollowSymLinks -MultiViews
RewriteBase /dinith/admin/
php_value post_max_size 100M
php_value upload_max_filesize 100M
php_value max_execution_time 300
php_value max_input_time 300
php_value max_file_uploads 50




RewriteRule ^login/?$ login.php [L]



RewriteRule ^dashboard/?$ index.php [L]
RewriteRule ^weddings/?$ manage_weddings.php [QSA,L]
RewriteRule ^packages/?$ manage_packages.php [QSA,L]
RewriteRule ^portfolio/?$ manage_portfolio.php [QSA,L]
RewriteRule ^testimonials/?$ manage_testimonials.php [QSA,L]
RewriteRule ^messages/?$ messages.php
RewriteRule ^logout/?$ logout.php [L]


<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
</IfModule>